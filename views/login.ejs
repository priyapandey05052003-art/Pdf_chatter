<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="w-full min-h-screen flex items-center justify-center bg-zinc-800">

        <form action="/login" method="POST"
              class="bg-zinc-700 flex flex-col gap-4 p-6 rounded-lg shadow-lg w-80">

            <h1 class="text-white text-2xl font-semibold text-center">
                Login
            </h1>

            <input
                class="px-3 py-2 rounded bg-zinc-600 text-white outline-none"
                type="email"
                name="email"
                placeholder="Enter email"
            >

            <input
                class="px-3 py-2 rounded bg-zinc-600 text-white outline-none"
                type="password"
                name="password"
                placeholder="Enter password"
            >

            <button
                class="bg-blue-600 text-white py-2 rounded hover:bg-blue-700 transition"
                type="submit">
                Login
            </button>
            <h3 class="text-white text-2xl font-semibold text-center">
                Create an account
            </h3>
            <div class="flex  gap-2">
                 <h3 class="text-white " >Do not have an account?</h3>
                 <a class="text-blue-400 underline" href="/signin">sign up</a>
            </div>


        </form>

    </div>
</body>
</html>